{
  "name": "vcl",
  "packageManager": "pnpm@12.5.1",
  "description": "Vehicle Cost Ledger",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm run -r build",
    "build:apps": "pnpm --filter \"./apps/**\" run build",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "lint": "eslint --cache && pnpm run -r lint",
    "lint:fix": "eslint --cache --fix && pnpm run -r lint:fix",
    "typecheck": "pnpm run -r typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "eslint": "10.11.0",
    "husky": "9.1.7"
  }
}
